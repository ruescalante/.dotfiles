{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "sway/workspaces",
        "sway/window"
    ],

    "modules-center": [
        "mpris"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "clock",
        "custom/notification",
        "custom/powermenu",
        "tray"
    ],

    // ── Workspaces ──────────────────────────────────────────────────────────
    "sway/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
	"disable-scroll": true,
        "all-outputs": true,
        "format-icons": {
            "1": "󰎤", "2": "󰎧", "3": "󰎪", "4": "󰎭", "5": "󰎱",
            "urgent": "󰀧", "focused": "󰮯", "default": "󰊠"
        },
        "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] }
    },

    // ── Active Window ───────────────────────────────────────────────────────
    "sway/window": {
        "format": "{title}",
        "max-length": 40,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹 $1",
            "(.*)kitty":             " terminal",
            "(.*)nvim(.*)":          " nvim"
        }
    },

    // ── Media (playerctl / MPRIS) ───────────────────────────────────────────
    // Clic izq   → play/pause
    // Clic der   → siguiente
    // Clic medio → anterior
    // Scroll     → volumen del player
    "mpris": {
        "format": "{player_icon} {artist} — {title}",
        "format-paused": "{player_icon} {artist} — {title}",
        "format-stopped": "",
        "player-icons": {
            "default":  "󰎈",
            "spotify":  "󰓇",
            "firefox":  "󰈹",
            "chromium": "󰊯",
            "vlc":      "󰕼",
            "mpv":      "󰔊"
        },
        "status-icons": {
            "playing": "󰐊",
            "paused":  "󰏤",
            "stopped": ""
        },
        "max-length": 48,
        "dynamic-len": true,
        "dynamic-importance-order": ["title", "artist", "position", "length"],
        "tooltip-format": "{status_icon}  {artist} · {album}\n 󰎈 {position} / {length}",
        "on-click":        "playerctl play-pause",
        "on-click-right":  "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up":    "playerctl volume 0.05+",
        "on-scroll-down":  "playerctl volume 0.05-"
    },

    // ── Powermenu ────────────────────────────────────────────────────────────
    "custom/powermenu": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Menú de Apagado",
        "on-click": "/home/ruben/.config/rofi/scripts/powermenu.sh"
    },

    // ── Notificaciones ───────────────────────────────────────────────────────
    "custom/notification": {
        "format": "󰂚",
        "tooltip": true,
        "tooltip-format": "Notificaciones",
        "on-click": "/home/ruben/.config/rofi/scripts/notifications.sh"
    },

    // ── Audio ───────────────────────────────────────────────────────────────
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset":   "󰋎",
            "default":   ["󰕿", "󰖀", "󰕾"]
        },
        "on-click":  "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip": false
    },

    // ── Network ─────────────────────────────────────────────────────────────
    "network": {
        "format-wifi":       "󰤨 {essid}",
        "format-ethernet":   "󰈀 eth",
        "format-disconnected":"󰤭",
        "tooltip-format":    "{ipaddr}  {signalStrength}%",
        "tooltip-format-ethernet": "{ipaddr}",
        "on-click": "nm-connection-editor"
    },

    // ── Battery ─────────────────────────────────────────────────────────────
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format":          "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged":  "󰚥 {capacity}%",
        "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "tooltip-format": "{timeTo} · {power:.1f}W"
    },

    // ── Clock ───────────────────────────────────────────────────────────────
   "clock": {
    "format": "󰅐 {:%H:%M}",
    "format-alt": " {:%a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
        "mode": "month",
        "weeks-pos": "left",
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
            "months":   "<span color='#ebdbb2'><b>{}</b></span>",
            "weekdays": "<span color='#d5c4a1'><b>{}</b></span>",
            "weeks":    "<span color='#665c54'>W{}</span>",
            "days":     "<span color='#a89984'>{}</span>",
            "today":    "<span color='#fabd2f'><b><u>{}</u></b></span>"
        }
    },
    "actions": {
        "on-scroll-up":   "shift_up",
        "on-scroll-down": "shift_down",
        "on-click-right": "mode"
    }
},

    // ── Tray ─────────────────────────────────────────────────────────────────
    "tray": {
        "icon-size": 14,
        "spacing": 6
    }
}
