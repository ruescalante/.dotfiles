/**
 * Gruvbox Fullscreen Powermenu Theme
 * 4 Tarjetas centradas con iconos SVG vectoriales nativos
 */

* {
    /* Paleta Gruvbox Dark */
    bg-dark:       rgba(40, 40, 40, 0.95);
    bg-card:       #3c3836;
    bg-selected:   #504945;

    fg:            #ebdbb2;
    fg-dim:        #a89984;
    fg-sub:        #7c6f64;

    /* Acentos de color Gruvbox */
    yellow:        #fabd2f;
    orange:        #fe8019;
    red:           #fb4934;
    green:         #b8bb26;
    blue:          #83a598;

    background-color: transparent;
    text-color:       @fg;
    border-color:     transparent;
    font:             "GeistMono Nerd Font 13";
}

/* ── Ventana principal a pantalla completa ──────────────────────────────── */
window {
    fullscreen:       true;
    background-color: @bg-dark;
    children:         [ mainbox ];
}

/* ── Contenedor principal con centrado vertical ──────────────────────────── */
mainbox {
    background-color: transparent;
    children:         [ dummy-top, listview, dummy-bottom ];
    padding:          0px;
    spacing:          0px;
}

dummy-top {
    expand: true;
}

dummy-bottom {
    expand: true;
}

/* ── Fila horizontal de 4 botones centrados ─────────────────────────────── */
listview {
    background-color: transparent;
    columns:          4;
    lines:            1;
    spacing:          28px;
    fixed-height:     false;
    scrollbar:        false;
    cycle:            true;
    dynamic:          true;
    margin:           0px 18%;
}

/* ── Tarjetas / Botones robustos ───────────────────────────────────────── */
element {
    background-color: @bg-card;
    text-color:       @fg-dim;
    border-radius:    20px;
    padding:          50px 15px;
    orientation:      vertical;
    cursor:           pointer;
    border:           3px;
    border-color:     rgba(80, 73, 69, 0.70);
    children:         [ element-icon, element-text ];
    spacing:          16px;
}

element normal.normal {
    background-color: @bg-card;
    text-color:       @fg-dim;
    border-color:     rgba(80, 73, 69, 0.70);
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg;
    border:           3px;
    border-color:     @yellow;
}

element alternate.normal {
    background-color: @bg-card;
    text-color:       @fg-dim;
    border-color:     rgba(80, 73, 69, 0.70);
}

/* ── Icono vectorial SVG nativo de Rofi ────────────────────────────────── */
element-icon {
    background-color: transparent;
    size:             64px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           pointer;
}

/* ── Etiqueta de Texto ──────────────────────────────────────────────────── */
element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "GeistMono Nerd Font 13";
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           pointer;
}
