/**
 * Gruvbox yt-dlp Menu Theme
 */
* {
    bg:        rgba(40, 40, 40, 0.95);
    bg-btn:    rgba(60, 56, 54, 0.65);
    bg-sel:    rgba(80, 73, 69, 0.90);
    fg:        #ebdbb2;
    fg-dim:    #a89984;
    yellow:    #fabd2f;
    green:     #b8bb26;

    background-color: transparent;
    text-color:       @fg;
    border-color:     @yellow;
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     rgba(80, 73, 69, 0.60);
    border-radius:    10px;
    width:            600px;
    padding:          20px;
    children:         [ inputbar, listview ];
}

inputbar {
    spacing:          10px;
    padding:          8px 12px;
    background-color: @bg-btn;
    border-radius:    6px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @yellow;
}

entry {
    placeholder:        "Ingresa o pega la URL del video...";
    placeholder-color:  @fg-dim;
}

listview {
    lines:        5;
    columns:      1;
    spacing:      6px;
    margin:       12px 0 0 0;
    fixed-height: false;
}

element {
    padding:       10px 14px;
    border-radius: 6px;
    cursor:        pointer;
}

element selected {
    background-color: @bg-sel;
    text-color:       @yellow;
}
