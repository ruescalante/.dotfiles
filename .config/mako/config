# === Configuración Global & Tema Gruvbox ===
max-visible=5
sort=-time
layer=overlay
anchor=top-right

font=sans-serif 10
width=320
height=110
margin=10
padding=12
border-size=2
border-radius=6
icons=1
max-icon-size=80
markup=1
actions=1
default-timeout=5000
ignore-timeout=0

# Colores del Tema Gruvbox (Modo Oscuro)
background-color=#282828
text-color=#ebdbb2
border-color=#d79921
progress-color=over #458588

# === Sonido de Notificaciones ===

# Sonido por defecto para cualquier notificación
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/message.oga

# === Reglas por Urgencia y Aplicación ===

# Notificaciones de Urgencia Baja
[urgency=low]
border-color=#504945
text-color=#928374

# Notificaciones Críticas (Batería baja, errores del sistema, alertas importantes)
[urgency=critical]
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/dialog-warning.oga
background-color=#7a0000
text-color=#fbf1c7
border-color=#fb4934
default-timeout=0

# Sonido específico para Firefox
[app-name=Firefox]
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/message-new-instant.oga

# Sonido específico para Chrome / Chromium
[app-name="Google Chrome"]
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/message-new-instant.oga

[app-name=Chromium]
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/message-new-instant.oga

# Silenciar sonido únicamente durante la actualización de barra de progreso de yt-dlp
[app-name=yt-dlp-progress]
on-notify=none

# Silenciar sonido genérico de Mako en capturas de pantalla (ya emitido por screenshot.sh)
[app-name=screenshot]
on-notify=none
